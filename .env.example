# Copy this file to .env, then fill in YOUR values.
# Never commit .env.

# Required. Create at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Primary search. Free key: https://app.tavily.com/
# DDGS remains the no-key fallback.
TAVILY_API_KEY=

# Model used for the final evaluation.
OPENROUTER_MODEL=google/gemini-2.5-flash

# Frozen FX rate for the cost table (INR per 1 USD).
USD_INR_RATE=83.5

# Frozen OpenRouter list prices used to estimate cost in rupees.
# ChatOpenRouter does not always return billed USD, so we convert tokens
# with these per-million-token rates. Update if you change models.
# Verified against OpenRouter's model endpoint on 25 September 2026.
INPUT_USD_PER_MILLION=0.30
OUTPUT_USD_PER_MILLION=2.50

# Context controls. These are cost-oriented limits, not the model's maximum.
MAX_MODEL_INPUT_TOKENS=12000
MAX_MODEL_OUTPUT_TOKENS=2000
