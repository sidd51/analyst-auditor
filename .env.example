# Copy this file to .env, then fill in YOUR values.
# Never commit .env.

# Required. Create at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# You choose the model. Recommended cheap default for this take-home:
#   openai/gpt-4o-mini
# Stronger (costs more):
#   google/gemini-2.5-flash
#   anthropic/claude-3.5-sonnet
OPENROUTER_MODEL=openai/gpt-4o-mini

# Frozen FX rate for the cost table (INR per 1 USD). Update if you want.
USD_INR_RATE=83.5

# Optional. If set, search uses Brave. If empty, we fall back to DuckDuckGo.
# Free key: https://brave.com/search/api/
BRAVE_API_KEY=
